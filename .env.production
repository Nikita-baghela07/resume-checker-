# Production Environment Configuration
# This file is used by Render deployment pipeline

# ── API Keys ───────────────────────────────────────────────────────────────
# ⚠️ IMPORTANT: Set GROQ_API_KEY in Render dashboard environment variables
# Get free key from: https://console.groq.com
GROQ_API_KEY=${GROQ_API_KEY}
MODEL_NAME=llama-3.1-8b-instant

# ── Model Configuration (CRITICAL FOR SIZE) ────────────────────────────────
# Set to 'false' in production to save 200+ MB RAM!
ENABLE_SBERT_MODEL=false

# ── Frontend Configuration ─────────────────────────────────────────────────
# Production Vercel URLs + local dev support
ALLOWED_ORIGINS=https://resume-checker-h4mi.vercel.app,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178,http://localhost:5179,http://localhost:5180,http://localhost:3000

# ── Database (Use PostgreSQL on Render) ────────────────────────────────────
# ⚠️ Render automatically injects DATABASE_URL from PostgreSQL addon
# No need to set it manually - Render provides it automatically
# For local testing if needed:
# DATABASE_URL=sqlite:///./optiresume.db

# ── Security ───────────────────────────────────────────────────────────────
# ⚠️ IMPORTANT: Set JWT_SECRET in Render dashboard environment variables
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=${JWT_SECRET}

# ── App Limits ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=5
MAX_RESUME_CHARS=8000
MAX_TOKENS=2000

# ── Deployment ─────────────────────────────────────────────────────────────
PYTHONUNBUFFERED=1
