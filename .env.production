# Production Environment Configuration
# Copy this to .env on deployment servers

# ── API Keys ───────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
MODEL_NAME=mixtral-8x7b-32768

# ── Model Configuration (CRITICAL FOR SIZE) ────────────────────────────────
# Set to 'false' in production to save 200+ MB RAM!
ENABLE_SBERT_MODEL=false

# ── Frontend Configuration ─────────────────────────────────────────────────
ALLOWED_ORIGINS=https://yourdomain.vercel.app,https://yourdomain.com

# ── Database (Use PostgreSQL on Render) ────────────────────────────────────
# For local SQLite (development):
# DATABASE_URL=sqlite:///./optiresume.db
# For PostgreSQL (production):
DATABASE_URL=postgresql://user:password@host:5432/optiresume

# ── Security ───────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_random_secure_string_with_openssl_rand_hex_32

# ── App Limits ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=5
MAX_RESUME_CHARS=8000

# ── Deployment ─────────────────────────────────────────────────────────────
PYTHONUNBUFFERED=1
