# Render Deployment Configuration
# For CPU-based deployment with limited RAM

# Use lightweight Python base image
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies only (minimal)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy deployment requirements (no SBERT/PyTorch)
COPY backend/requirements-deploy.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements-deploy.txt

# Copy application code
COPY . /app

# Backend startup
WORKDIR /app/resume-checker-/backend
ENV ENABLE_SBERT_MODEL=false
ENV PYTHONUNBUFFERED=1

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health')" || exit 1

# Run with gunicorn for production
CMD ["gunicorn", "-w", "2", "-b", "0.0.0.0:8000", "--timeout", "120", "--access-logfile", "-", "run:app"]
